#include <iostream>
#include <string>

using namespace std;

// Prototipos de funciones
void registrar(string &nombre, string &apellido);
string unirNombre(string nombre, string apellido);
int contarCaracteres(string nombre, string apellido);
void mostrar(string completo, int cantidad);

int main() {
    string nom, ape, nombreCompleto;
    int cantidadLetras;

    // Llamadas a las funciones
    registrar(nom, ape);
    nombreCompleto = unirNombre(nom, ape);
    cantidadLetras = contarCaracteres(nom, ape);
    
    mostrar(nombreCompleto, cantidadLetras);

    return 0;
}

// Definición de funciones
void registrar(string &nombre, string &apellido) {
    cout << "Ingrese el nombre: ";
    cin >> nombre;
    cout << "Ingrese el apellido: ";
    cin >> apellido;
}

string unirNombre(string nombre, string apellido) {
    return nombre + " " + apellido;
}

int contarCaracteres(string nombre, string apellido) {
    // Sumamos la longitud de ambas palabras (sin contar espacios)
    return nombre.length() + apellido.length();
}

void mostrar(string completo, int cantidad) {
    cout << "Nombre completo: " << completo << " | Letras: " << cantidad << endl;
}
