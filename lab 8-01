#include #include using namespace std;
int main(){
float calcularPromedio(float suma, int cantidad) {
return suma / cantidad;
}
bool aprobo(float promedio) {
return promedio >= 51;
}
int main() {
int cantidad;
float nota, suma = 0, promedio;

cout << "Ingrese la cantidad de evaluaciones: ";
cin >> cantidad;

if (cantidad <= 0) {
cout << "La cantidad debe ser mayor que cero." << endl;
return 1;
}

for (int i = 1; i <= cantidad; i++) {
do {
cout << "Ingrese la nota " << i << " (0-100): ";
cin >> nota;

if (nota < 0 || nota > 100) {
cout << "Nota invalida. Intente nuevamente." << endl;
}
} while (nota < 0 || nota > 100);

suma += nota;
}

promedio = calcularPromedio(suma, cantidad);

cout << fixed << setprecision(2);
cout << "\nPromedio final: " << promedio << endl;

if (aprobo(promedio)) {
cout << "Estado: APROBADO" << endl;
} else {
cout << "Estado: REPROBADO" << endl;
}

return 0;
}
