#include <iostream>
using namespace std;

// 1. Prototipos de funciones
void leerPeso(double &peso);
void calcularCosto(double peso, double &costo);
void mostrarResultado(double peso, double costo);

// 2. Funcion principal
int main() {
    double peso;
    double costo;

    leerPeso(peso);                     // Llama a la funcion leer
    calcularCosto(peso, costo);         // Llama a la funcion procesar
    mostrarResultado(peso, costo);      // Llama a la funcion mostrar

    return 0;
}

// 3. Detalles de las funciones
void leerPeso(double &peso) {
    cout << "Ingrese el peso de la carta en gramos: ";
    cin >> peso;
}

void calcularCosto(double peso, double &costo) {
    if (peso <= 0) {
        costo = -1; // Usamos -1 para error
    } else if (peso > 0 && peso < 50) {
        costo = 1.50;
    } else if (peso == 50) {
        costo = -2; // Usamos -2 para tarifa no definida
    } else if (peso > 50 && peso <= 100) {
        costo = 4.00;
    } else if (peso > 100 && peso <= 200) {
        costo = 6.00;
    } else if (peso > 200 && peso <= 350) {
        costo = 10.50;
    } else if (peso > 350 && peso <= 500) {
        costo = 15.00;
    } else if (peso > 500) {
        costo = -3; // Usamos -3 para no enviar
    }
}

void mostrarResultado(double peso, double costo) {
    if (costo == -1) {
        cout << "Peso no valido" << endl;
    } else if (costo == -2) {
        cout << "Tarifa no definida para 50 g" << endl;
    } else if (costo == -3) {
        cout << "NO PUEDE ENVIAR COMO CARTA" << endl;
    } else {
        cout << "Costo de envio: Bs " << costo << endl;
    }
}
