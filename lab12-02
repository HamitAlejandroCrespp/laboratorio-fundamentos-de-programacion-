#include <iostream>
#include <cmath>
using namespace std;

// 1. Prototipos de funciones
void leerCoeficientes(double &a, double &b, double &c);
double calcularDiscriminante(double a, double b, double c);
void calcularRaices(double a, double b, double discriminante, double &x1, double &x2);
void mostrarResultado(double a, double discriminante, double x1, double x2);

// 2. Funcion principal
int main() {
    double a, b, c;
    double discriminante, x1 = 0, x2 = 0;
    
    leerCoeficientes(a, b, c);                             // Llama a la funcion leer
    
    if (a == 0) {
        cout << "La ecuacion no es cuadratica." << endl;
    } else {
        discriminante = calcularDiscriminante(a, b, c);    // Llama a la funcion procesar
        if (discriminante >= 0) {
            calcularRaices(a, b, discriminante, x1, x2);
        }
        mostrarResultado(a, discriminante, x1, x2);        // Llama a la funcion mostrar
    }
    
    return 0;
}

// 3. Detalles de las funciones
void leerCoeficientes(double &a, double &b, double &c) {
    cout << "Ingrese a: "; 
    cin >> a;
    cout << "Ingrese b: "; 
    cin >> b;
    cout << "Ingrese c: "; 
    cin >> c;
}

double calcularDiscriminante(double a, double b, double c) {
    double d = (b * b) - (4 * a * c);
    return d;
}

void calcularRaices(double a, double b, double discriminante, double &x1, double &x2) {
    x1 = (-b + sqrt(discriminante)) / (2 * a);
    x2 = (-b - sqrt(discriminante)) / (2 * a);
}

void mostrarResultado(double a, double discriminante, double x1, double x2) {
    if (discriminante > 0) {
        cout << "Dos soluciones: x1 = " << x1 << ", x2 = " << x2 << endl;
    } else if (discriminante == 0) {
        cout << "Una solucion doble: x = " << x1 << endl;
    } else {
        cout << "No existen soluciones reales." << endl;
    }
}
